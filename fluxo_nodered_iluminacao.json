  {
    "id": "func_formatar_csv",
    "type": "function",
    "z": "tab_iluminacao",
    "name": "Formatar Linha CSV",
    "func": "var dados = msg.payload;\nvar agora = new Date().toISOString();\n\n// Garante o cabeçalho se o contexto estiver vazio\nvar leituras = flow.get('total_leituras') || 0;\nleituras++;\nflow.set('total_leituras', leituras);\n\n// Formato: timestamp, sala_id, presenca, luminosidade, rele_lampada, modo, contador\nvar linha = agora + ',' + \n            dados.sala_id + ',' + \n            dados.presenca + ',' + \n            dados.luminosidade + ',' + \n            dados.rele_lampada + ',' + \n            dados.modo + ',' + \n            leituras + '\\n';\n\nmsg.payload = linha;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 420,
    "wires": [["node_file_csv"]]
  },
  {
    "id": "node_file_csv",
    "type": "file",
    "z": "tab_iluminacao",
    "name": "Salvar leituras.csv",
    "filename": "leituras_sala101.csv",
    "filenameType": "str",
    "appendNewline": false,
    "createDir": true,
    "overwriteFile": "false",
    "encoding": "utf8",
    "x": 670,
    "y": 420,
    "wires": [[]]
  },
  {
    "id": "func_regra_automacao",
    "type": "function",
    "z": "tab_iluminacao",
    "name": "Regra Nuvem (Apoio à Decisão)",
    "func": "// Regra de Apoio e Alerta Automatizado em Nuvem:\n// Se a sala estiver desocupada por leituras seguidas e a lâmpada acusar LIGADA (falha de hardware),\n// ou se for detectada anomalia, a nuvem envia um comando forçado de desligamento.\n\nvar dados = msg.payload;\n\nif (dados.presenca === 0 && dados.rele_lampada === 'LIGADA') {\n    node.warn('ALERTA NUVEM: Lâmpada ligada sem ocupação detectada! Enviando desligamento forçado.');\n    return { payload: JSON.stringify({ acao: 'OFF', motivo: 'automacao_nuvem_desperdicio' }) };\n}\n\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 500,
    "wires": [["node_mqtt_out_comando"]]
  },
