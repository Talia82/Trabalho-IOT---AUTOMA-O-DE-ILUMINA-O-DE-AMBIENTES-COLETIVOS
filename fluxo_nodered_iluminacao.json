  {
    "id": "func_extrair_dados",
    "type": "function",
    "z": "tab_iluminacao",
    "name": "Separar Métricas",
    "func": "var dados = msg.payload;\n\n// 1. Mensagem para o Gráfico de Luminosidade\nvar msgLux = { payload: dados.luminosidade, topic: 'Luminosidade (ADC)' };\n\n// 2. Mensagem para o Indicador de Ocupação/Presença\nvar statusPresenca = dados.presenca === 1 ? 'Ocupada (Movimento)' : 'Vazia (Sem Presença)';\nvar msgPresenca = { payload: statusPresenca };\n\n// 3. Mensagem para o Indicador da Lâmpada\nvar msgLampada = { payload: dados.rele_lampada };\n\nreturn [msgLux, msgPresenca, msgLampada];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 200,
    "wires": [
      ["ui_chart_luminosidade", "ui_gauge_lux"],
      ["ui_text_presenca"],
      ["ui_text_lampada"]
    ]
  },
