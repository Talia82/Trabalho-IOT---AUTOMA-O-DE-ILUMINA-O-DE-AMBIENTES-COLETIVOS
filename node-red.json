    {
        "id": "87026aab0cadb1a5",
        "type": "function",
        "z": "0254a884076e699d",
        "name": "Formatar Linha CSV",
        "func": "var dados = msg.payload;\nvar agora = new Date().toISOString();\n\n// Garante o cabeçalho se o contexto estiver vazio\nvar leituras = flow.get('total_leituras') || 0;\nleituras++;\nflow.set('total_leituras', leituras);\n\n// Formato: timestamp, sala_id, presenca, luminosidade, rele_lampada, modo, contador\nvar linha = agora + ',' + \n            dados.sala_id + ',' + \n            dados.presenca + ',' + \n            dados.luminosidade + ',' + \n            dados.rele_lampada + ',' + \n            dados.modo + ',' + \n            leituras + '\\n';\n\nmsg.payload = linha;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 420,
        "wires": [
            [
                "5285fcec6cc472fc"
            ]
        ]
    },
